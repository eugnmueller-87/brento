#!/bin/sh
# Runs inside Apple's Installer, for the person installing. It unpacks Daytag into that person's own Library and hands
# over to install.sh, which sets up the start at login and the Daytag app. No admin rights, and nothing outside the
# home folder. An update goes the same way: the new copy is complete and tried out before the old one is touched.
set -e
HERE=$(cd "$(dirname "$0")" && pwd)

if [ "$(id -u)" -eq 0 ]; then
  # Started with admin rights all the same: go on as the person at the screen, never as root.
  WHO=$(stat -f %Su /dev/console)
  if [ "$WHO" = "root" ]; then
    echo "Daytag installs for the person at the screen, and nobody is signed in."
    exit 1
  fi
  COPY=$(mktemp -d /private/tmp/daytag.XXXXXX)
  cp -R "$HERE/." "$COPY/"
  chown -R "$WHO" "$COPY"
  RC=0
  launchctl asuser "$(id -u "$WHO")" sudo -u "$WHO" -H /bin/sh "$COPY/postinstall" || RC=$?
  rm -rf "$COPY"
  exit $RC
fi

BASE="$HOME/Library/Application Support/Daytag"
NEW="$HOME/Library/Application Support/Daytag.new"
OLD="$HOME/Library/Application Support/Daytag.old"
KEEP="$HOME/.daytag"

# The chip of this Mac, also when this script itself runs translated.
CHIP=x86_64
[ "$(sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" = "1" ] && CHIP=arm64
echo "Daytag for $CHIP, into $BASE"

rm -rf "$NEW" "$OLD"
mkdir -p "$NEW"
tar -xzf "$HERE/daytag.tar.gz" -C "$NEW"
tar -xzf "$HERE/runtime-$CHIP.tar.gz" -C "$NEW"

# Tried out before anything else changes: if this Mac cannot run it, the installation stops here and says so.
"$NEW/python/bin/Daytag" -c 'import http.server, json, ssl, sys, zipfile; print("Python", sys.version.split()[0])'
"$NEW/app/bin/gh" --version

# A team's own setup file stays, unless the new version brings one.
for TEAM in "$BASE/app/team.json" "$KEEP/team.json"; do
  if [ -f "$TEAM" ] && [ ! -f "$NEW/app/team.json" ]; then cp -p "$TEAM" "$NEW/app/team.json"; fi
done

if [ -x "$BASE/python/bin/Daytag" ] && [ -f "$BASE/app/launcher.py" ]; then
  "$BASE/python/bin/Daytag" "$BASE/app/launcher.py" --stop || true
fi
if [ -d "$BASE" ]; then mv "$BASE" "$OLD"; fi
mv "$NEW" "$BASE"
rm -rf "$OLD"

DAYTAG_PACKAGED=1 DAYTAG_PYTHON="$BASE/python/bin/Daytag" /bin/sh "$BASE/app/install.sh"
